
rules_version = '2';

/**
 * Vidya EduCare - Elite Production Security Rules
 */
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn() && 
        (request.auth.token.email.lower() == 'admin@vidyaeducare.com' || request.auth.token.email.lower() == 'headadmin@vidyaeducare.com');
    }

    function isAdmin() {
      return signedIn() && (isMaster() || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'Active' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['Head Admin', 'Sub-admin', 'Finance Admin', 'Academic Admin', 'Support Admin']));
    }

    function hasRole(roles) {
      return isAdmin() && (isMaster() || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in roles);
    }
    function financeAdmin() { return hasRole(['Head Admin', 'Sub-admin', 'Finance Admin']); }
    function academicAdmin() { return hasRole(['Head Admin', 'Sub-admin', 'Academic Admin']); }
    function configurationAdmin() { return hasRole(['Head Admin', 'Sub-admin']); }
    function headAdmin() { return hasRole(['Head Admin']); }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsStudent(studentId) {
      return signedIn() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.parentId == request.auth.uid;
    }

    function isPaidStudent(studentId) {
      return ownsStudent(studentId) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.mockTestSubscribed == true;
    }

    function isScheduledTestLive(testId) {
      let scheduledTest = get(/databases/$(database)/documents/scheduledTests/$(testId)).data;
      return !('startsAt' in scheduledTest) ||
        (scheduledTest.startsAt is timestamp &&
          scheduledTest.duration is int &&
          scheduledTest.startsAt <= request.time &&
          request.time < scheduledTest.startsAt + duration.value(scheduledTest.duration * 60, 's'));
    }

    // --- GLOBAL CONFIGURATIONS ---
    // Public for system consistency (Pricing, Bank Details, Academic Rules)
    match /configs/{document=**} {
      allow read: if true; 
      allow write: if configurationAdmin();
    }

    // --- USER PROFILE & ACCESS ---
    match /users/{uid} {
      allow list: if isAdmin();
      allow get: if isOwner(uid) || isAdmin();
      allow create: if true;
      allow update: if isAdmin() || (isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'purchasedMockTest', 'commission_rate', 'accountStatus', 'subscriptionStatus',
          'remunerationEligibilityStatus', 'managementApprovalStatus'
        ]));
      allow delete: if isAdmin();
    }

    match /aiAccess/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if configurationAdmin();
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || financeAdmin();
      allow list: if financeAdmin(); 
      allow create: if isOwner(uid) && request.resource.data.balance == 0 && request.resource.data.coins == 0;
      allow update: if financeAdmin();
    }

    match /activationCodes/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isMaster() && request.resource.data.role in ['Head Admin', 'Sub-admin', 'Finance Admin', 'Academic Admin', 'Support Admin'] && request.resource.data.status in ['Active', 'Pending', 'Rejected'];
      allow delete: if isMaster();
    }

    match /chats/{uid} {
      allow read, write, list: if isOwner(uid) || isAdmin();
      match /messages/{mid} {
        allow read, write, list: if isOwner(uid) || isAdmin();
      }
    }

    match /referbolt/{uid} {
      allow read, list: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
    }

    match /students/{id} {
      allow read, list: if signedIn();
      allow write: if isAdmin() || (resource != null && resource.data.parentId == request.auth.uid) || (request.resource != null && request.resource.data.parentId == request.auth.uid);
    }
    
    match /transactions/{id} {
      allow read, list: if signedIn() && (financeAdmin() || resource.data.user == request.auth.uid);
      // Existing prize/purchase entries remain supported. Deposit/withdrawal decisions are server-only.
      allow create: if financeAdmin() && !(request.resource.data.type in ['deposit', 'withdrawal']);
      allow update, delete: if false;
    }
    match /paymentUtrClaims/{id} { allow read, write: if false; }
    match /adminBulkPreviews/{id} { allow read, write: if false; }
    match /adminAuditLogs/{id} { allow read: if financeAdmin(); allow write: if false; }

    match /testSets/{id} {
      allow read, list: if true;
      allow create: if academicAdmin();
      allow update: if academicAdmin();
      allow delete: if academicAdmin();
    }

    match /scheduledTests/{id} {
      allow read, list: if true;
      allow create: if academicAdmin();
      allow update: if academicAdmin();
      allow delete: if false;
    }

    match /testResults/{id} {
      allow read, list: if signedIn();
      allow create: if signedIn() &&
        ownsStudent(request.resource.data.studentId) &&
        request.resource.data.testId is string &&
        request.resource.data.isLive is bool &&
        (!request.resource.data.isLive || isScheduledTestLive(request.resource.data.testId)) &&
        request.resource.data.rankingEligible is bool &&
        request.resource.data.perTestCashPrizeEligible is bool &&
        request.resource.data.monthlyCashPrizeEligible is bool &&
        request.resource.data.accessType is string &&
        (!request.resource.data.rankingEligible || (
          isPaidStudent(request.resource.data.studentId) &&
          request.resource.data.isLive == true &&
          request.resource.data.accessType == 'PAID_SUBSCRIPTION' &&
          request.resource.data.perTestCashPrizeEligible == true &&
          request.resource.data.monthlyCashPrizeEligible == true
        ));
    }

    match /leaderboard/{id} {
      allow read, list: if true;
      allow create: if signedIn() &&
        isPaidStudent(request.resource.data.studentId) &&
        request.resource.data.testId is string &&
        isScheduledTestLive(request.resource.data.testId) &&
        get(/databases/$(database)/documents/testResults/$(id)).data.isLive == true &&
        request.resource.data.accessType == 'PAID_SUBSCRIPTION' &&
        request.resource.data.testWindowStatus == 'LIVE' &&
        request.resource.data.rankingEligible == true &&
        request.resource.data.perTestCashPrizeEligible == true &&
        request.resource.data.monthlyCashPrizeEligible == true &&
        get(/databases/$(database)/documents/testResults/$(id)).data.rankingEligible == true;
      allow update, delete: if isAdmin();
    }

    match /quizClashTournaments/{id} {
      allow read, list: if true;
      allow write: if configurationAdmin();
    }

    match /quizClashResults/{id} {
      allow read, list: if true;
      allow write: if true;
    }
    
    match /notifications/{id} {
      allow read, list: if signedIn() &&
        (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isAdmin();
      allow update: if signedIn() &&
        (isAdmin() || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']) &&
        request.resource.data.status == 'read';
      allow delete: if isAdmin();
    }
    
    match /clients/{id} {
      allow read, list: if isAdmin() || (signedIn() && resource.data.referrerId == request.auth.uid);
      allow write: if configurationAdmin();
    }

    // Remuneration policy and financial source-of-truth records are written only
    // through authenticated server APIs (Admin SDK bypasses client rules).
    match /ibaRemunerationPolicies/{id} {
      allow get: if isAdmin() || (resource.data.active == true && resource.data.status == 'PUBLISHED');
      allow list: if isAdmin();
      allow write: if false;
    }

    match /ibaPolicyHistory/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ibaSales/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    match /ibaPerformance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    match /ibaEligibility/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    match /ibaPayouts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    match /ibaPayoutHistory/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    match /ibaFixedRemunerationClaims/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    match /purchaseRequests/{id} {
      allow read, write: if false;
    }

    // StoryTeller financial, entitlement, generation and audit records are
    // server-authoritative. Users can only read their own projects/orders.
    match /storytellerProjects/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /storytellerOrders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /storytellerJobs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /storytellerPurchaseRequests/{id} { allow read, write: if false; }
    match /storytellerVoiceReferences/{id} { allow read, write: if false; }
    match /storytellerConfigHistory/{id} { allow read: if isAdmin(); allow write: if false; }

    // Life & Relationship Consultancy: all mutations go through server APIs.
    // Matching is also server mediated so protected profile fields are never
    // downloaded and merely hidden by the UI.
    match /consultancyProfileFields/{id} { allow read: if true; allow write: if false; }
    match /matrimonialProfiles/{uid} { allow read: if isAdmin() || isOwner(uid); allow write: if false; }
    match /consultancyVerifications/{uid} { allow read: if isAdmin() || isOwner(uid); allow write: if false; }
    match /matrimonialInterests/{id} { allow read: if isAdmin() || (signedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid)); allow write: if false; }
    match /matrimonialMutualInterests/{id} { allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds); allow write: if false; }
    match /matrimonialMeetings/{id} { allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds); allow write: if false; }
    match /meetingParticipantPayments/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /marriageMatches/{id} { allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantIds); allow write: if false; }
    match /successFeeObligations/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /consultancyEntitlements/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /consultancyOrders/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /counsellingServices/{id} { allow read: if true; allow write: if false; }
    match /counsellingAvailability/{id} { allow read: if true; allow write: if false; }
    match /counsellingBookings/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /counsellingSlots/{id} { allow read: if isAdmin(); allow write: if false; }
    match /counsellingDayCounters/{id} { allow read: if isAdmin(); allow write: if false; }
    match /consultancyDocumentVersions/{id} { allow read: if isAdmin() || resource.data.status == 'PUBLISHED'; allow write: if false; }
    match /consultancyAcceptances/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /consultancyComplaints/{id} { allow read: if isAdmin() || (signedIn() && resource.data.reportedBy == request.auth.uid); allow write: if false; }
    match /consultancyAuditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /consultancyConfigHistory/{id} { allow read: if isAdmin(); allow write: if false; }
    match /consultancyPaymentRequests/{id} { allow read, write: if false; }
    match /consultancyActionRequests/{id} { allow read, write: if false; }
    match /ibaMatrimonialCommissionPolicies/{id} {
      allow read: if isAdmin() || (resource.data.status == 'PUBLISHED' && resource.data.active == true);
      allow write: if false;
    }
    match /ibaMatrimonialReferrals/{customerId} {
      allow read: if isAdmin() || isOwner(customerId) ||
        (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }
    match /ibaMatrimonialCommissions/{id} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.ibaUid == request.auth.uid);
      allow write: if false;
    }

    // --- MASTER OVERRIDE ---
    match /{allPaths=**} {
      allow read: if isMaster();
    }
  }
}

