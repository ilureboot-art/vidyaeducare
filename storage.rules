rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Demo assets may be public. User source/output assets are always accessed
    // through authenticated server APIs and short-lived signed URLs.
    match /storyteller/demo/{allPaths=**} { allow read: if true; allow write: if false; }
    match /storyteller/{allPaths=**} { allow read, write: if false; }
    match /consultancy/{allPaths=**} { allow read, write: if false; }
  }
}
